.my-container {
  background-color: #f8f8f8;
  min-height: 100vh;
  padding: 20rpx;
  /* 登录弹窗样式 */
}
.my-container .user-card {
  background-color: #ffffff;
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.my-container .user-card .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #eee;
  margin-right: 30rpx;
}
.my-container .user-card .info {
  display: flex;
  flex-direction: column;
}
.my-container .user-card .info .nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.my-container .user-card .info .status {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.my-container .menu-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}
.my-container .menu-list .menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
  transition: background-color 0.2s;
}
.my-container .menu-list .menu-item:last-child {
  border-bottom: none;
}
.my-container .menu-list .menu-item:active {
  background-color: #fafafa;
}
.my-container .menu-list .menu-item .left {
  display: flex;
  align-items: center;
}
.my-container .menu-list .menu-item .left .icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  /* 如果你想让星星颜色特别一点，可以单独加颜色 */
  /* color: #f1c40f; */
}
.my-container .menu-list .menu-item .left .text {
  font-size: 30rpx;
  color: #444;
}
.my-container .menu-list .menu-item .arrow {
  color: #ccc;
  font-size: 24rpx;
}
.my-container .logout-btn {
  margin-top: 60rpx;
  background-color: #fff;
  color: #ff5a5f;
  border-radius: 50rpx;
  font-size: 30rpx;
  height: 90rpx;
  line-height: 90rpx;
  border: 1rpx solid #ff5a5f;
}
.my-container .logout-btn:active {
  opacity: 0.8;
}
.my-container .login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.my-container .login-modal .modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}
.my-container .login-modal .modal-content {
  position: relative;
  width: 80%;
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  animation: modalFadeIn 0.3s ease-out;
}
.my-container .login-modal .modal-content .modal-header {
  text-align: center;
  margin-bottom: 50rpx;
}
.my-container .login-modal .modal-content .modal-header .modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.my-container .login-modal .modal-content .modal-header .modal-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}
.my-container .login-modal .modal-content .avatar-wrapper {
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin: 0 auto 50rpx;
  background: #f8f8f8;
  position: relative;
  border: none;
}
.my-container .login-modal .modal-content .avatar-wrapper::after {
  border: none;
}
.my-container .login-modal .modal-content .avatar-wrapper .modal-avatar {
  width: 100%;
  height: 100%;
  border-radius: 80rpx;
}
.my-container .login-modal .modal-content .avatar-wrapper .edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: #ff5a5f;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}
.my-container .login-modal .modal-content .avatar-wrapper .edit-badge .edit-icon {
  color: #fff;
  font-size: 24rpx;
}
.my-container .login-modal .modal-content .input-group {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}
.my-container .login-modal .modal-content .input-group .label {
  font-size: 28rpx;
  color: #666;
  margin-right: 30rpx;
}
.my-container .login-modal .modal-content .input-group .nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.my-container .login-modal .modal-content .modal-footer {
  display: flex;
  justify-content: space-between;
}
.my-container .login-modal .modal-content .modal-footer .btn {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.my-container .login-modal .modal-content .modal-footer .btn::after {
  border: none;
}
.my-container .login-modal .modal-content .modal-footer .btn.cancel {
  background: #f5f5f5;
  color: #999;
}
.my-container .login-modal .modal-content .modal-footer .btn.confirm {
  background: #ff5a5f;
  color: #fff;
}
@keyframes modalFadeIn {
from {
    opacity: 0;
    transform: scale(0.9);
}
to {
    opacity: 1;
    transform: scale(1);
}
}