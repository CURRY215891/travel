<view class="my-container"><view class="user-card" bindtap="{{d}}"><image class="avatar" src="{{a}}"></image><view class="info"><text class="nickname">{{b}}</text><text class="status">{{c}}</text></view></view><view wx:if="{{e}}" class="login-modal"><view class="modal-mask" bindtap="{{f}}"></view><view class="modal-content"><view class="modal-header"><text class="modal-title">完善个人信息</text><text class="modal-tip">请选择头像并填写昵称</text></view><button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="{{h}}"><image class="modal-avatar" src="{{g}}"></image><view class="edit-badge"><text class="edit-icon">✎</text></view></button><view class="input-group"><text class="label">昵称</text><input type="nickname" class="nickname-input" placeholder="请输入昵称" bindblur="{{i}}" bindinput="{{j}}" value="{{k}}"/></view><view class="modal-footer"><button class="btn cancel" bindtap="{{l}}">取消</button><button class="btn confirm" bindtap="{{m}}">确定登录</button></view></view></view><view class="menu-list"><view class="menu-item" bindtap="{{n}}"><view class="left"><text class="icon">📝</text><text class="text">我的动态</text></view><text class="arrow">&gt;</text></view><view class="menu-item" bindtap="{{o}}"><view class="left"><text class="icon">📅</text><text class="text">我的预订</text></view><text class="arrow">&gt;</text></view><view class="menu-item" bindtap="{{p}}"><view class="left"><text class="icon">⭐</text><text class="text">我的收藏</text></view><text class="arrow">&gt;</text></view><view class="menu-item" bindtap="{{q}}"><view class="left"><text class="icon">💬</text><text class="text">我的评论</text></view><text class="arrow">&gt;</text></view></view><button wx:if="{{r}}" class="logout-btn" bindtap="{{s}}">退出当前登录</button></view>