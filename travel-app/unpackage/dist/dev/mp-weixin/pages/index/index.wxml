<view class="container"><view class="search-box"><view class="location-tag" bindtap="{{b}}"><text class="iconfont">📍</text><text class="city">{{a}}</text></view><view class="search-input"><icon type="search" size="16" color="#999"/><input type="text" placeholder="搜索目的地/景点" class="input-field" confirm-type="search" bindconfirm="{{c}}" bindinput="{{d}}" bindfocus="{{e}}" value="{{f}}"/><icon wx:if="{{g}}" type="clear" size="16" color="#ccc" bindtap="{{h}}"/></view><view wx:if="{{i}}" class="search-suggestions"><view wx:for="{{j}}" wx:for-item="item" wx:key="b" class="suggestion-item" bindtap="{{item.c}}"><text class="suggestion-name">{{item.a}}</text><text class="iconfont arrow-right">&gt;</text></view></view><view wx:if="{{k}}" class="search-mask" bindtap="{{l}}"></view></view><swiper class="banner" circular autoplay interval="3000" indicator-dots indicator-color="rgba(255,255,255,0.6)" indicator-active-color="#fff"><swiper-item wx:for="{{m}}" wx:for-item="img" wx:key="b"><image src="{{img.a}}" mode="aspectFill"></image></swiper-item></swiper><view class="category-section"><view wx:for="{{n}}" wx:for-item="item" wx:key="c" class="category-item" bindtap="{{item.d}}"><image src="{{item.a}}" mode="aspectFit"></image><text>{{item.b}}</text></view></view><view class="list-section"><view class="section-title">热门景点推荐</view><view wx:for="{{o}}" wx:for-item="item" wx:key="e" class="attraction-card" bindtap="{{item.f}}"><image class="cover" src="{{item.a}}" mode="aspectFill"></image><view class="info"><text class="name">{{item.b}}</text><view class="tags"><text class="tag">必打卡</text><text class="tag">高人气</text></view><view class="price-box"><text class="price">￥{{item.c}}</text><text class="unit">{{item.d}}</text></view></view></view></view></view>