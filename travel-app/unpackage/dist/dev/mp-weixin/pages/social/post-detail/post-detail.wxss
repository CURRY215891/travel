/* 文章场景相关 */
.detail-container {
  background: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}
.loading {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}
.user-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
}
.user-bar .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.user-bar .nickname {
  font-weight: bold;
  font-size: 30rpx;
}
.user-bar .time {
  font-size: 24rpx;
  color: #999;
}
.main-content {
  padding: 0 30rpx 40rpx;
}
.main-content .text-desc {
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
}

/* 多图展示样式 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.post-images .img-item {
  width: 220rpx;
  height: 220rpx;
  border-radius: 10rpx;
  background-color: #f0f0f0;
}
.post-images .img-item:only-child {
  width: 450rpx;
  height: 450rpx;
}

/* 操作栏样式修正 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1rpx solid #eee;
  margin: 0 30rpx;
}
.action-bar .like-btn, .action-bar .fav-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #999;
}
.action-bar .like-btn .iconfont, .action-bar .fav-btn .iconfont {
  font-size: 38rpx;
  margin-right: 8rpx;
}
.action-bar .like-btn.liked {
  color: #ff4444;
}
.action-bar .like-btn.liked .iconfont {
  color: #ff4444;
  animation: heartBeat 0.3s;
}
.action-bar .fav-btn.faved {
  color: #f1c40f;
}
.action-bar .fav-btn.faved .iconfont {
  color: #f1c40f;
}
@keyframes heartBeat {
0% {
    transform: scale(1);
}
50% {
    transform: scale(1.3);
}
100% {
    transform: scale(1);
}
}
.comment-area {
  border-top: 20rpx solid #f8f8f8;
  padding: 30rpx;
}
.comment-area .area-title {
  font-weight: bold;
  margin-bottom: 30rpx;
}
.comment-area .no-comment {
  text-align: center;
  color: #ccc;
  padding: 40rpx 0;
}
.comment-area .comment-item {
  display: flex;
  margin-bottom: 30rpx;
}
.comment-area .comment-item .c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.comment-area .comment-item .c-right {
  flex: 1;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}
.comment-area .comment-item .c-right .c-user {
  display: flex;
  justify-content: space-between;
}
.comment-area .comment-item .c-right .c-user .c-name {
  font-size: 26rpx;
  color: #666;
}
.comment-area .comment-item .c-right .c-user .c-time {
  font-size: 22rpx;
  color: #bbb;
}
.comment-area .comment-item .c-right .c-text {
  font-size: 28rpx;
  color: #333;
  margin-top: 10rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.bottom-bar .msg-input {
  flex: 1;
  background: #f4f4f4;
  height: 70rpx;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}
.bottom-bar .send-btn {
  margin-left: 20rpx;
  width: 100rpx;
  text-align: center;
  color: #007aff;
  font-weight: bold;
  font-size: 30rpx;
}