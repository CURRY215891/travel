<view class="detail-container"><view wx:if="{{a}}"><view class="user-bar"><image src="{{b}}" class="avatar"></image><view class="info"><view class="nickname">{{c}}</view><view class="time">{{d}}</view></view></view><view class="main-content"><view class="text-desc">{{e}}</view><view wx:if="{{f}}" class="post-images"><image wx:for="{{g}}" wx:for-item="src" wx:key="a" src="{{src.b}}" mode="aspectFill" class="img-item" bindtap="{{src.c}}"></image></view></view><view class="action-bar"><view bindtap="{{j}}" class="{{['like-btn', k && 'liked']}}"><text class="iconfont">{{h}}</text><text class="num">{{i}}</text></view><view bindtap="{{n}}" class="{{['fav-btn', o && 'faved']}}"><text class="iconfont">{{l}}</text><text class="text">{{m}}</text></view></view><view class="comment-area"><view class="area-title">全部评论 ({{p}})</view><view wx:if="{{q}}" class="no-comment">暂无评论，快来抢沙发~</view><view wx:for="{{r}}" wx:for-item="c" wx:key="e" class="comment-item"><image src="{{c.a}}" class="c-avatar"></image><view class="c-right"><view class="c-user"><text class="c-name">{{c.b}}</text><text class="c-time">{{c.c}}</text></view><view class="c-text">{{c.d}}</view></view></view></view><view class="bottom-bar"><input class="msg-input" placeholder="写下你的精彩评论..." cursor-spacing="20" value="{{s}}" bindinput="{{t}}"/><view class="send-btn" bindtap="{{v}}">发送</view></view></view><view wx:else class="loading">加载中...</view></view>