<view class="detail-container"><swiper class="banner" circular autoplay indicator-dots><swiper-item wx:for="{{a}}" wx:for-item="img" wx:key="b"><image src="{{img.a}}" mode="aspectFill"></image></swiper-item></swiper><view class="info-section"><view class="header"><view class="title-row"><text class="name">{{b}}</text><view class="fav-btn" bindtap="{{e}}"><text class="iconfont" style="{{'color:' + d}}">{{c}}</text></view></view><view class="price-box"><text class="price">￥{{f}}</text><text class="unit">{{g}}</text></view></view><view class="meta-info"><view wx:if="{{h}}" class="meta-item"><text class="meta-label">{{i}}：</text><text class="meta-value">{{j}}</text></view></view><view class="address-bar" bindtap="{{n}}"><text class="addr-text">📍 {{k}}</text><text wx:if="{{l}}" class="distance">距您 {{m}}</text><view class="nav-btn">去这里</view></view></view><view class="desc-section"><view class="title">{{o}}</view><text class="content">{{p}}</text></view><view class="comment-section"><view class="section-title">用户评价 ({{q}})</view><view class="comment-list"><view wx:for="{{r}}" wx:for-item="item" wx:key="n" class="comment-group"><view class="comment-item"><image src="{{item.a}}" class="avatar"></image><view class="content-box"><view class="user-info"><text class="nickname">{{item.b}}</text><text class="time">{{item.c}}</text></view><view wx:if="{{item.d}}" class="star-row"><text wx:for="{{item.e}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}">★</text></view><view class="text">{{item.f}}</view><view wx:if="{{item.g}}" class="delete-btn" bindtap="{{item.h}}">删除</view></view></view><view wx:if="{{item.i}}" class="reply-list"><view wx:for="{{item.j}}" wx:for-item="reply" wx:key="e" class="reply-item"><view class="reply-content-box"><view class="reply-header"><text class="reply-tag">追评</text><text class="time">{{reply.a}}</text></view><view class="text">{{reply.b}}</view><view wx:if="{{reply.c}}" class="delete-btn" bindtap="{{reply.d}}">删除</view></view></view><view wx:if="{{item.k}}" class="expand-btn" bindtap="{{item.m}}">{{item.l}}</view></view></view><view wx:if="{{s}}" class="empty-comment"> 暂无评价，快来抢沙发吧~ </view></view></view><view class="bottom-bar"><input type="text" placeholder="说点什么吧..." class="input" value="{{t}}" bindinput="{{v}}"/><view wx:if="{{w}}" class="star-selector"><text wx:for="{{x}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view><view class="send-btn" bindtap="{{y}}">发布</view></view></view>