/* 文章场景相关 */
.container {
  min-height: 100vh;
  background-color: #f8fbff;
  padding: 30rpx;
}

/* 输入框样式优化 */
.input-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.05);
  margin-bottom: 30rpx;
}
.input-section .content-input {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}
.input-section .placeholder-style {
  color: #b0c4de;
}
.input-section .word-count {
  text-align: right;
  font-size: 24rpx;
  color: #9db2cc;
  margin-top: 10rpx;
}

/* 图片区域样式优化 */
.image-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.05);
}
.image-section .section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #334e68;
  margin-bottom: 24rpx;
}
.image-section .section-title .sub-title {
  font-weight: normal;
  color: #9db2cc;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-list .image-item {
  width: 190rpx;
  height: 190rpx;
  position: relative;
}
.image-list .image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #e1e9f5;
}
.image-list .image-item .delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background-color: #ff5e5e;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.image-list .image-item .delete-btn .delete-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: -2rpx;
}

/* 上传按钮样式优化 */
.add-img-btn {
  width: 190rpx;
  height: 190rpx;
  background-color: #f0f7ff;
  border: 2rpx dashed #007aff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.add-img-btn:active {
  background-color: #e0eeff;
  transform: scale(0.98);
}
.add-img-btn .plus-icon {
  font-size: 56rpx;
  color: #007aff;
  margin-bottom: 4rpx;
}
.add-img-btn .add-text {
  font-size: 22rpx;
  color: #007aff;
}

/* 发布按钮样式优化 */
.btn-section {
  margin-top: 60rpx;
}
.btn-section .submit-btn {
  background: linear-gradient(135deg, #4dabff 0%, #007aff 100%);
  color: #ffffff;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 10rpx 20rpx rgba(0, 122, 255, 0.2);
}
.btn-section .submit-btn:after {
  border: none;
}
.btn-section .submit-btn[disabled] {
  background: #cce5ff;
  color: #ffffff;
  box-shadow: none;
}
.btn-section .submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}