<view class="container"><view class="header-card"><view class="info"><text class="hotel-name">{{a}}</text><text class="room-name">{{b}}</text></view></view><view class="rating-section"><view class="rating-item"><text class="label">酒店评分</text><view class="stars"><text wx:for="{{c}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view></view><view class="rating-item"><text class="label">房间卫生</text><view class="stars"><text wx:for="{{d}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view></view><view class="rating-item"><text class="label">周边环境</text><view class="stars"><text wx:for="{{e}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view></view><view class="rating-item"><text class="label">酒店服务</text><view class="stars"><text wx:for="{{f}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view></view><view class="rating-item"><text class="label">设备设施</text><view class="stars"><text wx:for="{{g}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}" bindtap="{{s.c}}">★</text></view></view></view><view class="content-section"><block wx:if="{{r0}}"><textarea class="comment-input" placeholder="分享您的入住体验吧..." maxlength="500" value="{{h}}" bindinput="{{i}}"/></block><view class="word-count">{{j}}/500</view></view><view class="image-section"><view class="section-title">添加图片</view><view class="image-list"><view wx:for="{{k}}" wx:for-item="img" wx:key="d" class="image-item"><image src="{{img.a}}" mode="aspectFill" bindtap="{{img.b}}"></image><view class="delete-btn" bindtap="{{img.c}}">×</view></view><view wx:if="{{l}}" class="add-img-btn" bindtap="{{m}}"><text class="plus">+</text><text class="txt">上传图片</text></view></view></view><view class="footer"><button class="submit-btn" bindtap="{{n}}">发布评价</button></view></view>