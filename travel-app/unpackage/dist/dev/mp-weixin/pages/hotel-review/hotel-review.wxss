.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 150rpx;
}
.header-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}
.header-card .info .hotel-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.header-card .info .room-name {
  font-size: 28rpx;
  color: #666;
}
.rating-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}
.rating-section .rating-item {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}
.rating-section .rating-item:last-child {
  margin-bottom: 0;
}
.rating-section .rating-item .label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}
.rating-section .rating-item .stars {
  display: flex;
}
.rating-section .rating-item .stars .star {
  font-size: 40rpx;
  color: #eee;
  margin-right: 15rpx;
}
.rating-section .rating-item .stars .star.active {
  color: #ffca28;
}
.content-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}
.content-section .comment-input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333;
}
.content-section .word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.image-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
}
.image-section .section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 25rpx;
}
.image-section .image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-section .image-list .image-item {
  width: 190rpx;
  height: 190rpx;
  position: relative;
}
.image-section .image-list .image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.image-section .image-list .image-item .delete-btn {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.image-section .image-list .add-img-btn {
  width: 190rpx;
  height: 190rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.image-section .image-list .add-img-btn .plus {
  font-size: 60rpx;
  color: #999;
  margin-bottom: 5rpx;
}
.image-section .image-list .add-img-btn .txt {
  font-size: 24rpx;
  color: #999;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.footer .submit-btn {
  background: #ff5a5f;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}