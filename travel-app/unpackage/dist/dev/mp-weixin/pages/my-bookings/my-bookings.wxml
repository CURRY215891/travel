<view class="container"><view class="tabs"><view wx:for="{{a}}" wx:for-item="item" wx:key="b" class="{{['tab-item', item.c && 'active']}}" bindtap="{{item.d}}">{{item.a}}</view></view><scroll-view scroll-y class="booking-list"><view wx:for="{{b}}" wx:for-item="item" wx:key="x" class="booking-card"><view class="card-header"><text class="hotel-name">{{item.a}}</text><text class="{{['status-text', item.c]}}">{{item.b}}</text></view><view class="card-body" bindtap="{{item.i}}"><image src="{{item.d}}" mode="aspectFill" class="room-img"></image><view class="room-info"><text class="room-name">{{item.e}}</text><view class="date-info"><text class="date">{{item.f}} 至 {{item.g}}</text></view><view class="price-info"><text class="label">总价：</text><text class="symbol">￥</text><text class="price">{{item.h}}</text></view></view></view><view class="card-footer"><text class="create-time">下单时间：{{item.j}}</text><view class="btn-group"><button wx:if="{{item.k}}" class="btn pay" bindtap="{{item.l}}">立即支付</button><button wx:if="{{item.m}}" class="btn cancel" bindtap="{{item.n}}">取消订单</button><button wx:if="{{item.o}}" class="btn cancel" bindtap="{{item.p}}">取消订单</button><button wx:if="{{item.q}}" class="btn refund" bindtap="{{item.r}}">申请退款</button><button wx:if="{{item.s}}" class="btn comment" bindtap="{{item.t}}">去评价</button><button wx:if="{{item.v}}" class="btn delete" bindtap="{{item.w}}">删除订单</button></view></view></view><view wx:if="{{c}}" class="empty-box"><image src="{{d}}" mode="aspectFit" class="empty-img"></image><text class="empty-text">暂无相关订单</text></view></scroll-view></view>