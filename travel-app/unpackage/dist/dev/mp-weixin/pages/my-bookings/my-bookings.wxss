.container {
  background: #f8f8f8;
  min-height: 100vh;
}
.tabs {
  display: flex;
  background: #fff;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tabs .tab-item.active {
  color: #ff5a5f;
  font-weight: bold;
  position: relative;
}
.tabs .tab-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #ff5a5f;
  border-radius: 2rpx;
}
.booking-list {
  padding: 20rpx;
}
.booking-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.booking-card .card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
}
.booking-card .card-header .hotel-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.booking-card .card-header .status-text {
  font-size: 26rpx;
}
.booking-card .card-header .status-text.status-0 {
  color: #ff9800;
}
.booking-card .card-header .status-text.status-1 {
  color: #ff9800;
}
.booking-card .card-header .status-text.status-2 {
  color: #2196f3;
}
.booking-card .card-header .status-text.status-3 {
  color: #4caf50;
}
.booking-card .card-header .status-text.status-4 {
  color: #007aff;
}
.booking-card .card-header .status-text.status-5 {
  color: #999;
}
.booking-card .card-header .status-text.status-6 {
  color: #ff9800;
}
.booking-card .card-header .status-text.status-7 {
  color: #999;
}
.booking-card .card-body {
  display: flex;
  margin-bottom: 25rpx;
}
.booking-card .card-body .room-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.booking-card .card-body .room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.booking-card .card-body .room-info .room-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.booking-card .card-body .room-info .date-info {
  font-size: 24rpx;
  color: #666;
}
.booking-card .card-body .room-info .price-info .label {
  font-size: 24rpx;
  color: #999;
}
.booking-card .card-body .room-info .price-info .symbol {
  font-size: 24rpx;
  color: #ff5a5f;
}
.booking-card .card-body .room-info .price-info .price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff5a5f;
}
.booking-card .card-footer {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.booking-card .card-footer .create-time {
  font-size: 22rpx;
  color: #999;
}
.booking-card .card-footer .btn-group {
  display: flex;
}
.booking-card .card-footer .btn-group .btn {
  margin-left: 15rpx;
  font-size: 24rpx;
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
  background: #f8f8f8;
  color: #666;
}
.booking-card .card-footer .btn-group .btn::after {
  border: none;
}
.booking-card .card-footer .btn-group .btn.pay {
  background: #ff5a5f;
  color: #fff;
}
.booking-card .card-footer .btn-group .btn.cancel {
  border: 1rpx solid #ddd;
  background: #fff;
  color: #666;
}
.booking-card .card-footer .btn-group .btn.refund {
  border: 1rpx solid #ff9800;
  background: #fff;
  color: #ff9800;
}
.booking-card .card-footer .btn-group .btn.comment {
  border: 1rpx solid #ff5a5f;
  color: #ff5a5f;
  background: #fff;
}
.booking-card .card-footer .btn-group .btn.delete {
  border: 1rpx solid #999;
  background: #fff;
  color: #999;
}
.empty-box {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-box .empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}
.empty-box .empty-text {
  font-size: 28rpx;
  color: #999;
}