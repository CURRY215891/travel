.banner {
  height: 450rpx;
  width: 100%;
}
.banner image {
  width: 100%;
  height: 100%;
}
.info-section {
  padding: 30rpx;
  background: #fff;
}
.info-section .title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.info-section .title-row .name {
  font-size: 36rpx;
  font-weight: bold;
}
.info-section .title-row .fav-btn {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #f8f8f8;
}
.info-section .price-box {
  color: #ff5a5f;
  margin: 10rpx 0;
}
.info-section .price-box .price {
  font-size: 40rpx;
  font-weight: bold;
}
.info-section .price-box .unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}
.info-section .tags-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.info-section .tags-row .tag {
  font-size: 20rpx;
  background: #eef5ff;
  color: #007aff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.info-section .meta-info {
  margin-bottom: 20rpx;
}
.info-section .meta-info .meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.info-section .meta-info .meta-item .meta-label {
  color: #999;
  margin-right: 10rpx;
}
.info-section .meta-info .meta-item .meta-value {
  color: #333;
}
.info-section .address-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}
.info-section .address-bar .addr-text {
  flex: 1;
  margin-right: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-section .address-bar .distance {
  font-size: 24rpx;
  color: #007aff;
  margin-right: 20rpx;
}
.info-section .address-bar .nav-btn {
  font-size: 26rpx;
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  color: #333;
  font-weight: 500;
}
.desc-section {
  padding: 30rpx;
}
.desc-section .title {
  font-weight: bold;
  margin-bottom: 10rpx;
}
.desc-section .content {
  line-height: 1.6;
  color: #666;
  font-size: 28rpx;
}
.room-section {
  padding: 30rpx;
  background: #fff;
  margin-top: 20rpx;
}
.room-section .section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #007aff;
  padding-left: 20rpx;
}
.room-section .room-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.room-section .room-item .room-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.room-section .room-item .room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.room-section .room-item .room-info .room-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.room-section .room-item .room-info .room-desc {
  font-size: 24rpx;
  color: #999;
}
.room-section .room-item .room-info .room-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.room-section .room-item .room-info .room-bottom .room-price {
  color: #ff5a5f;
}
.room-section .room-item .room-info .room-bottom .room-price .symbol {
  font-size: 24rpx;
}
.room-section .room-item .room-info .room-bottom .room-price .num {
  font-size: 36rpx;
  font-weight: bold;
}
.room-section .room-item .room-info .room-bottom .book-btn {
  background: #007aff;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
}
.room-section .empty-room {
  text-align: center;
  padding: 50rpx;
  color: #999;
  font-size: 28rpx;
}