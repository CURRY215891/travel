<view class="detail-container"><swiper class="banner" circular autoplay indicator-dots><swiper-item wx:for="{{a}}" wx:for-item="img" wx:key="b"><image src="{{img.a}}" mode="aspectFill"></image></swiper-item></swiper><view class="info-section"><view class="header"><view class="title-row"><text class="name">{{b}}</text><view class="fav-btn" bindtap="{{e}}"><text class="iconfont" style="{{'color:' + d}}">{{c}}</text></view></view><view class="price-box"><text class="price">￥{{f}}</text><text class="unit">/晚起</text></view><view wx:if="{{g}}" class="tags-row"><text wx:for="{{h}}" wx:for-item="tag" wx:key="b" class="tag">{{tag.a}}</text></view></view><view class="meta-info"><view wx:if="{{i}}" class="meta-item"><text class="meta-label">酒店星级：</text><text class="meta-value">{{j}}星级</text></view><view wx:if="{{k}}" class="meta-item"><text class="meta-label">酒店设施：</text><text class="meta-value">{{l}}</text></view></view><view class="address-bar" bindtap="{{p}}"><text class="addr-text">📍 {{m}}</text><text wx:if="{{n}}" class="distance">距您 {{o}}</text><view class="nav-btn">去这里</view></view></view><view class="desc-section"><view class="title">酒店介绍</view><text class="content">{{q}}</text></view><view class="room-section"><view class="section-title">房型预订</view><view class="room-list"><view wx:for="{{r}}" wx:for-item="room" wx:key="e" class="room-item" bindtap="{{room.f}}"><image src="{{room.a}}" class="room-img" mode="aspectFill"></image><view class="room-info"><view class="room-name">{{room.b}}</view><view class="room-desc">{{room.c}}</view><view class="room-bottom"><view class="room-price"><text class="symbol">￥</text><text class="num">{{room.d}}</text></view><view class="book-btn">预订</view></view></view></view><view wx:if="{{s}}" class="empty-room"> 暂无房型信息 </view></view></view></view>