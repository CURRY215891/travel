.booking-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding: 20rpx;
  padding-bottom: 120rpx;
}
.room-card {
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.room-card .room-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}
.room-card .room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.room-card .room-info .room-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.room-card .room-info .hotel-name {
  font-size: 24rpx;
  color: #999;
}
.room-card .room-info .price-box {
  color: #ff5a5f;
}
.room-card .room-info .price-box .symbol {
  font-size: 20rpx;
}
.room-card .room-info .price-box .price {
  font-size: 36rpx;
  font-weight: bold;
}
.room-card .room-info .price-box .unit {
  font-size: 20rpx;
  color: #999;
}
.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.form-section .section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 15rpx;
  border-left: 6rpx solid #ff5a5f;
}
.form-section .form-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-section .form-item:last-child {
  border-bottom: none;
}
.form-section .form-item .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}
.form-section .form-item .picker-value, .form-section .form-item .input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-section .stay-days {
  text-align: right;
  font-size: 24rpx;
  color: #ff5a5f;
  margin-top: 10rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.bottom-bar .total-info {
  flex: 1;
}
.bottom-bar .total-info .label {
  font-size: 28rpx;
  color: #333;
}
.bottom-bar .total-info .symbol {
  font-size: 24rpx;
  color: #ff5a5f;
}
.bottom-bar .total-info .price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5a5f;
}
.bottom-bar .submit-btn {
  width: 240rpx;
  height: 80rpx;
  background: #ff5a5f;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}
.bottom-bar .submit-btn.disabled {
  background: #ccc;
}