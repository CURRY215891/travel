<view class="booking-container"><view class="room-card"><image src="{{a}}" mode="aspectFill" class="room-img"></image><view class="room-info"><view class="room-name">{{b}}</view><view class="hotel-name">{{c}}</view><view class="price-box"><text class="symbol">￥</text><text class="price">{{d}}</text><text class="unit">/晚</text></view></view></view><view class="form-section"><view class="section-title">预订日期</view><view class="form-item"><text class="label">入住日期</text><picker mode="date" start="{{f}}" bindchange="{{g}}"><view class="picker-value">{{e}}</view></picker></view><view class="form-item"><text class="label">退房日期</text><picker mode="date" start="{{i}}" bindchange="{{j}}"><view class="picker-value">{{h}}</view></picker></view><view wx:if="{{k}}" class="stay-days">共 {{l}} 晚</view></view><view class="form-section"><view class="section-title">入住人信息</view><view class="form-item"><text class="label">姓名</text><input type="text" placeholder="请输入入住人姓名" class="input" value="{{m}}" bindinput="{{n}}"/></view><view class="form-item"><text class="label">联系电话</text><input type="number" placeholder="请输入联系电话" class="input" value="{{o}}" bindinput="{{p}}"/></view></view><view class="bottom-bar"><view class="total-info"><text class="label">合计：</text><text class="symbol">￥</text><text class="price">{{q}}</text></view><view class="submit-btn" bindtap="{{r}}">提交订单</view></view></view>