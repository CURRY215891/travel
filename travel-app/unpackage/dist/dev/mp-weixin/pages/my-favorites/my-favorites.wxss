.fav-container {
  background-color: #f8f8f8;
  min-height: 100vh;
  /* 顶部 Tab 栏 */
  /* 列表区域 */
  /* 空状态 */
}
.fav-container .tab-header {
  display: flex;
  background-color: #fff;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eee;
}
.fav-container .tab-header .tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.fav-container .tab-header .tab.active {
  color: #007aff;
  font-weight: bold;
}
.fav-container .tab-header .tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
}
.fav-container .list-content {
  padding: 20rpx;
  /* 景点卡片样式 */
}
.fav-container .list-content .post-card {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.fav-container .list-content .post-card .post-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  /* 最多显示两行，超出省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-box-clamp: 2;
  overflow: hidden;
}
.fav-container .list-content .post-card .post-info {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}
.fav-container .list-content .attr-card {
  display: flex;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.fav-container .list-content .attr-card .attr-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.fav-container .list-content .attr-card .attr-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}
.fav-container .list-content .attr-card .attr-info .attr-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.fav-container .list-content .attr-card .attr-info .attr-address {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.fav-container .list-content .attr-card .attr-info .attr-price {
  font-size: 28rpx;
  color: #ff5a5f;
  font-weight: bold;
  margin-top: 10rpx;
}
.fav-container .empty {
  padding-top: 200rpx;
  text-align: center;
  color: #ccc;
  font-size: 28rpx;
}
.fav-container .empty .empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: block;
}