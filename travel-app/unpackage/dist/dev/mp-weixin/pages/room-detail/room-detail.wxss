.detail-container {
  padding-bottom: 120rpx;
  background: #f8f8f8;
  min-height: 100vh;
}
.detail-container .room-banner {
  height: 500rpx;
  width: 100%;
}
.detail-container .room-banner .banner-img {
  width: 100%;
  height: 100%;
}
.detail-container .info-section {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.detail-container .info-section .header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.detail-container .info-section .header .name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.detail-container .info-section .header .price-box {
  color: #ff5a5f;
}
.detail-container .info-section .header .price-box .symbol {
  font-size: 24rpx;
}
.detail-container .info-section .header .price-box .price {
  font-size: 48rpx;
  font-weight: bold;
}
.detail-container .info-section .header .price-box .unit {
  font-size: 24rpx;
  color: #999;
}
.detail-container .info-section .room-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}
.detail-container .info-section .room-tags .tag {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 15rpx;
  margin-bottom: 10rpx;
}
.detail-container .desc-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.detail-container .desc-section .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.detail-container .desc-section .content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}
.detail-container .desc-section .facility-list {
  display: flex;
  flex-wrap: wrap;
}
.detail-container .desc-section .facility-list .facility-item {
  width: 50%;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}
.detail-container .desc-section .facility-list .facility-item .dot {
  color: #ff5a5f;
  margin-right: 10rpx;
  font-weight: bold;
}
.detail-container .desc-section .no-data {
  font-size: 26rpx;
  color: #999;
}
.detail-container .comment-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-top: 20rpx;
}
.detail-container .comment-section .title-bar {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.detail-container .comment-section .title-bar .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.detail-container .comment-section .title-bar .count {
  font-size: 26rpx;
  color: #999;
  margin-left: 10rpx;
}
.detail-container .comment-section .no-comment {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.detail-container .comment-section .comment-list .comment-item {
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
  margin-bottom: 30rpx;
}
.detail-container .comment-section .comment-list .comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}
.detail-container .comment-section .comment-list .comment-item .user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.detail-container .comment-section .comment-list .comment-item .user-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right {
  flex: 1;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .date-row .date {
  font-size: 24rpx;
  color: #999;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .date-row .stars {
  display: flex;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .date-row .stars .star {
  font-size: 24rpx;
  color: #eee;
}
.detail-container .comment-section .comment-list .comment-item .user-info .right .date-row .stars .star.active {
  color: #ffca28;
}
.detail-container .comment-section .comment-list .comment-item .rating-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
}
.detail-container .comment-section .comment-list .comment-item .rating-tags .tag {
  background: #fdf5f5;
  color: #ff5a5f;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.detail-container .comment-section .comment-list .comment-item .comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.detail-container .comment-section .comment-list .comment-item .comment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}
.detail-container .comment-section .comment-list .comment-item .comment-images .img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.bottom-bar .price-info {
  flex: 1;
}
.bottom-bar .price-info .label {
  font-size: 24rpx;
  color: #666;
}
.bottom-bar .price-info .symbol {
  font-size: 24rpx;
  color: #ff5a5f;
}
.bottom-bar .price-info .num {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5a5f;
}
.bottom-bar .price-info .unit {
  font-size: 24rpx;
  color: #999;
}
.bottom-bar .book-btn {
  width: 240rpx;
  height: 74rpx;
  background: #ff5a5f;
  color: #fff;
  border-radius: 37rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}