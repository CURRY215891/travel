<view class="detail-container"><view class="room-banner"><image src="{{a}}" mode="aspectFill" class="banner-img"></image></view><view class="info-section"><view class="header"><text class="name">{{b}}</text><view class="price-box"><text class="symbol">￥</text><text class="price">{{c}}</text><text class="unit">/晚</text></view></view><view wx:if="{{d}}" class="room-tags"><text class="tag">{{e}}</text><text class="tag">{{f}}㎡</text><text class="tag">含早餐</text><text class="tag">免费WiFi</text></view></view><view class="desc-section"><view class="title">房型介绍</view><text class="content">{{g}}</text></view><view class="comment-section"><view class="title-bar"><text class="title">房客评价</text><text wx:if="{{h}}" class="count">({{i}})</text></view><view wx:if="{{j}}" class="no-comment"><text>暂无评价</text></view><view wx:else class="comment-list"><view wx:for="{{k}}" wx:for-item="item" wx:key="l" class="comment-item"><view class="user-info"><image src="{{item.a}}" mode="aspectFill" class="avatar"></image><view class="right"><view class="name">{{item.b}}</view><view class="date-row"><text class="date">{{item.c}}</text><view class="stars"><text wx:for="{{item.d}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'active']}}">★</text></view></view></view></view><view class="rating-tags"><view class="tag">卫生 {{item.e}}</view><view class="tag">环境 {{item.f}}</view><view class="tag">服务 {{item.g}}</view><view class="tag">设施 {{item.h}}</view></view><view class="comment-content">{{item.i}}</view><view wx:if="{{item.j}}" class="comment-images"><image wx:for="{{item.k}}" wx:for-item="img" wx:key="a" src="{{img.b}}" mode="aspectFill" class="img" bindtap="{{img.c}}"></image></view></view></view></view></view><view class="bottom-bar"><view class="price-info"><text class="label">单价：</text><text class="symbol">￥</text><text class="num">{{l}}</text><text class="unit">/晚</text></view><view class="book-btn" bindtap="{{m}}">立即预订</view></view>