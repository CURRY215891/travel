.detail-container {
  padding-bottom: 120rpx;
  background: #f8f8f8;
}
.banner {
  height: 450rpx;
  width: 100%;
}
.banner image {
  width: 100%;
  height: 100%;
}
.info-section {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.info-section .header {
  margin-bottom: 20rpx;
}
.info-section .header .title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.info-section .header .title-row .name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.info-section .header .title-row .fav-btn {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #f8f8f8;
}
.info-section .header .price-box {
  margin-top: 10rpx;
}
.info-section .header .price-box .price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5a5f;
}
.info-section .header .price-box .unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}
.info-section .meta-info {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}
.info-section .meta-info .meta-item {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}
.info-section .meta-info .meta-item .meta-label {
  color: #999;
  width: 140rpx;
}
.info-section .meta-info .meta-item .meta-value {
  color: #333;
  flex: 1;
}
.info-section .address-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}
.info-section .address-bar .addr-text {
  flex: 1;
  margin-right: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-section .address-bar .distance {
  font-size: 24rpx;
  color: #007aff;
  margin-right: 20rpx;
}
.info-section .address-bar .nav-btn {
  padding: 6rpx 20rpx;
  background: #007aff;
  color: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.desc-section {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.desc-section .title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 15rpx;
  border-left: 8rpx solid #007aff;
}
.desc-section .content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
.comment-section {
  padding: 30rpx;
  background: #fff;
}
.comment-section .section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.comment-section .comment-item {
  display: flex;
  margin-bottom: 30rpx;
}
.comment-section .comment-item .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}
.comment-section .comment-item .content-box {
  flex: 1;
}
.comment-section .comment-item .content-box .user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.comment-section .comment-item .content-box .user-info .nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.comment-section .comment-item .content-box .user-info .time {
  font-size: 24rpx;
  color: #999;
}
.comment-section .comment-item .content-box .star-row {
  margin-bottom: 10rpx;
}
.comment-section .comment-item .content-box .star-row .star {
  color: #ccc;
  font-size: 24rpx;
}
.comment-section .comment-item .content-box .star-row .star.active {
  color: #ffca28;
}
.comment-section .comment-item .content-box .text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}
.comment-section .comment-item .content-box .delete-btn {
  font-size: 24rpx;
  color: #ff5a5f;
  margin-top: 10rpx;
  text-align: right;
}
.comment-section .reply-list {
  margin-left: 100rpx;
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 10rpx;
}
.comment-section .reply-list .reply-item {
  margin-bottom: 15rpx;
}
.comment-section .reply-list .reply-item:last-child {
  margin-bottom: 0;
}
.comment-section .reply-list .reply-item .reply-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 5rpx;
}
.comment-section .reply-list .reply-item .reply-header .reply-tag {
  font-size: 22rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.comment-section .reply-list .reply-item .reply-header .time {
  font-size: 22rpx;
  color: #999;
}
.comment-section .reply-list .reply-item .text {
  font-size: 26rpx;
  color: #666;
}
.comment-section .reply-list .reply-item .delete-btn {
  font-size: 22rpx;
  color: #ff5a5f;
  text-align: right;
  margin-top: 5rpx;
}
.comment-section .reply-list .expand-btn {
  font-size: 24rpx;
  color: #007aff;
  text-align: center;
  margin-top: 15rpx;
  padding: 10rpx 0;
}
.comment-section .empty-comment {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}
.bottom-bar .input {
  flex: 1;
  height: 70rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}
.bottom-bar .star-selector {
  margin: 0 20rpx;
}
.bottom-bar .star-selector .star {
  color: #ccc;
  font-size: 32rpx;
}
.bottom-bar .star-selector .star.active {
  color: #ffca28;
}
.bottom-bar .send-btn {
  width: 120rpx;
  height: 70rpx;
  background: #007aff;
  color: #fff;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-left: 20rpx;
}